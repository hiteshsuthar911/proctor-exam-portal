# Environment Variables — Copy to .env (never commit .env to git!)

# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/proctordb?retryWrites=true&w=majority

# JWT secret — use a long random string (min 32 chars)
JWT_SECRET=change-this-to-a-very-long-random-secret-string-min-32-chars

# Admin credentials (for /admin panel login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Server port (Render sets this automatically)
PORT=3000
